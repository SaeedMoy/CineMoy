{
  "name": "cinemoy",
  "version": "0.2.1",
  "description": "Compact movie/series streaming app: Cinemeta catalog + Torrentio streams + Farsi subtitles. Runs on Windows (Electron), web and TV browsers.",
  "homepage": "https://cinemoy.fun",
  "author": {
    "name": "Saeed Moy",
    "email": "SaeedMoy@users.noreply.github.com"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "desktop": "electron .",
    "build:win": "electron-builder --win portable nsis",
    "bundle:android": "node scripts/bundle-server.mjs",
    "build:android": "node scripts/build-android.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "express": "^4.21.2",
    "iconv-lite": "^0.6.3",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "app.cinemoy",
    "productName": "CineMoy",
    "files": [
      "server/**",
      "web/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "icon": "build/icon.png",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "CineMoy"
    },
    "portable": {
      "artifactName": "CineMoy-${version}-portable.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "identity": "-",
      "artifactName": "CineMoy-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "CineMoy ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "synopsis": "Movies & series with Farsi subtitles",
      "artifactName": "CineMoy-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "cinemoy_${version}_${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
